NODE_ENV=development
PORT=8787
APP_URL=http://localhost:8787

# Shopify Dev Dashboard credentials
SHOPIFY_CLIENT_ID=replace_me
SHOPIFY_CLIENT_SECRET=replace_me
SHOPIFY_SCOPES=read_themes,write_themes
SHOPIFY_API_VERSION=2026-07

# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=replace_with_32_byte_base64_key
SESSION_SECRET=replace_with_a_long_random_session_secret
API_KEY_PEPPER=replace_with_a_different_long_random_secret

# PostgreSQL. The app uses an in-memory store only when this is absent in development.
DATABASE_URL=postgresql://sectionos:sectionos@localhost:5432/sectionos

# Optional Shopify billing. Keep disabled until plan pricing is decided.
BILLING_ENABLED=false
SHOPIFY_PLAN_NAME=Section OS Pro
SHOPIFY_PLAN_PRICE=0
SHOPIFY_PLAN_CURRENCY=USD
SHOPIFY_PLAN_TRIAL_DAYS=14

# Legacy single-store connector for local development only.
SHOPIFY_SHOP=
SHOPIFY_ADMIN_ACCESS_TOKEN=
