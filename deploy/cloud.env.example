# ThemeBot Cloud — production settings.
#
# On the server this file lives at /etc/themebot-cloud/cloud.env (owner root, mode 600) and is read
# by systemd (themebot-cloud.service). setup-server.sh creates it from this template and fills in the
# three generated secrets for you; you fill in the mail and Lemon Squeezy lines by hand:
#
#     sudo nano /etc/themebot-cloud/cloud.env
#     sudo systemctl restart themebot-cloud
#
# Format rules (systemd EnvironmentFile):
#   * one NAME=value per line; comments only on their own line (a "# ..." after a value becomes part
#     of the value);
#   * quote values that contain spaces or < > characters, e.g. MAIL_FROM="ThemeBot <login@x.com>";
#   * an empty value means "not set".
#
# KEEP A COPY OF THIS WHOLE FILE IN YOUR PASSWORD MANAGER. If the server is lost, the database backup
# is useless without CLOUD_PEPPER, and every installed app is locked out without CLOUD_SIGNING_KEY.

# --- Fixed for this server layout (leave as they are) -------------------------------------------

NODE_ENV=production
# Only Caddy (on the same machine) talks to the Cloud; Caddyfile and deploy.sh expect 127.0.0.1:8800.
CLOUD_HOST=127.0.0.1
CLOUD_PORT=8800
# SQLite database (cloud.sqlite) lives here. Backed up nightly by themebot-cloud-backup.timer.
CLOUD_DATA_DIR=/var/lib/themebot-cloud
# Number of reverse proxies in front of the Cloud: 1 (Caddy). The app then rate-limits per real
# visitor address. Never "true" (lets clients fake their address); "false" puts everyone in one bucket.
# Add Cloudflare's proxy in front of Caddy later? Then Caddy needs trusted_proxies, see Caddy's docs.
CLOUD_TRUST_PROXY=1

# --- Secrets generated for you (setup-server.sh, or: node gen-secrets.mjs) -----------------------

# Ed25519 private key that signs every pass. ONE line with \n escapes, in single quotes, e.g.
#   CLOUD_SIGNING_KEY='-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEI...\n-----END PRIVATE KEY-----'
# Its public half is pinned inside every desktop installer (THEMEBOT_CLOUD_PUBKEY). NEVER change it
# casually: a new key locks out every installed app until customers install a build made with the
# new public key. Print the public key with: node gen-secrets.mjs --pubkey /etc/themebot-cloud/cloud.env
CLOUD_SIGNING_KEY=

# Secret mixed into every stored hash (sign-in codes, refresh tokens, device fingerprints) and into
# the prompt watermarks. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# NEVER change it: a new pepper signs every customer out and breaks leak tracing of past prompts.
CLOUD_PEPPER=

# Bearer token for the admin API (/v1/admin/*). At least 24 characters. Empty = admin API off.
# Rotate any time: node gen-secrets.mjs --rotate-admin-token /etc/themebot-cloud/cloud.env
ADMIN_TOKEN=

# --- Sign-in emails (Resend) — REQUIRED, the Cloud refuses to start without both -----------------

# resend.com → API Keys → Create API Key (permission: "Sending access", domain: your sending domain).
# Looks like re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=
# The sender. Its domain must be VERIFIED in Resend (Domains → Add Domain → add the DNS records).
# Example: MAIL_FROM="ThemeBot <login@mail.example.com>"
MAIL_FROM=

# --- Payments (Lemon Squeezy) — optional; without the secret the webhook answers 503 --------------

# Lemon Squeezy → Settings → Webhooks → (+) → URL https://<your cloud domain>/v1/webhooks/lemonsqueezy,
# a "Signing secret" you make up (e.g. node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"),
# events order_created + order_refunded + all subscription_* events. Paste the same signing secret here.
LEMONSQUEEZY_WEBHOOK_SECRET=
# Optional: your store's numeric id (Settings → Stores). Events from any other store are ignored.
LEMONSQUEEZY_STORE_ID=
# Seats per ThemeBot variant, "variantId:seats,variantId:seats" e.g. 12345:3,67890:10
# This is also the list of what grants a ThemeBot account: a purchase of any other product in your
# store is ignored. Fill in this line and/or LEMONSQUEEZY_PRODUCT_IDS — if BOTH are empty (and the
# admin variantSeats setting too), purchases grant NOTHING and the Cloud warns at start.
LEMONSQUEEZY_VARIANT_SEATS=
# Optional: ThemeBot product ids, "productId,productId". Every variant of these products grants an
# account (seats from the line above, else LEMONSQUEEZY_DEFAULT_SEATS) — handy when you add variants.
LEMONSQUEEZY_PRODUCT_IDS=
# Seats for an allowed variant not listed above.
LEMONSQUEEZY_DEFAULT_SEATS=3
# Test-mode purchases are ignored in production. Set to 1 only to try the live server with Lemon
# Squeezy's test mode, and remove it afterwards (test purchases then create real accounts).
LEMONSQUEEZY_ALLOW_TEST_MODE=

# --- App version gate ---------------------------------------------------------------------------

# Oldest desktop app version allowed to sign in (the admin setting minAppVersion overrides it).
MIN_APP_VERSION=0.0.0

# --- Rarely needed --------------------------------------------------------------------------------

# Where the build recipe is read from at start. Default: the recipe/ folder of the running release
# (/opt/themebot-cloud/current/recipe). Only set this to try a recipe that is not part of a release.
#CLOUD_RECIPE_DIR=
# SQLite file. Default: $CLOUD_DATA_DIR/cloud.sqlite (backup.sh assumes the default).
#CLOUD_DB_FILE=
