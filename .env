NODE_ENV=development
PORT=8787
APP_URL=http://localhost:8787

# Shopify Dev Dashboard credentials (placeholders for local dev)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_themes,write_themes
SHOPIFY_API_VERSION=2026-07

# Dev fallbacks are applied by server/config.ts when these are blank.
APP_ENCRYPTION_KEY=
SESSION_SECRET=
API_KEY_PEPPER=

# Left blank so development uses in-memory storage (no Postgres required).
DATABASE_URL=

BILLING_ENABLED=false
